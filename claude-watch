#!/usr/bin/env bash
#
# claude-watch — auto-reconnect wrapper for "claude remote-control"
#
# Usage: ./claude-watch [options]
#
#   Options:
#     --name NAME     Session name passed to remote-control
#     --verbose       Enable verbose logging in remote-control
#     --sandbox       Run in sandbox mode
#     --no-sandbox    Disable sandbox mode
#     -h, --help      Show this help
#
#   Environment variables:
#     CLAUDE_CMD            claude binary (default: claude)
#     BACKOFF_INITIAL       initial retry delay in seconds (default: 2)
#     BACKOFF_MAX           max retry delay in seconds (default: 30)
#     BACKOFF_MULTIPLIER    backoff multiplier (default: 2)
#     BACKOFF_RESET_AFTER   reset backoff after N seconds of stable uptime (default: 120)
#     MAX_RETRIES           max reconnect attempts, 0=unlimited (default: 0)
#
# The remote-control session uses HTTPS polling and will exit if it
# loses connectivity for ~10 minutes, or after rate-limit resets.
# This wrapper detects those exits and starts a fresh session.
#
set -euo pipefail

# ── Configuration (override via environment) ─────────────────────
CLAUDE_CMD="${CLAUDE_CMD:-claude}"
BACKOFF_INITIAL="${BACKOFF_INITIAL:-2}"
BACKOFF_MAX="${BACKOFF_MAX:-30}"
BACKOFF_MULTIPLIER="${BACKOFF_MULTIPLIER:-2}"
BACKOFF_RESET_AFTER="${BACKOFF_RESET_AFTER:-120}"
MAX_RETRIES="${MAX_RETRIES:-0}"

# ── Parse arguments ──────────────────────────────────────────────
RC_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            sed -n '3,/^$/s/^# \?//p' "$0"
            exit 0
            ;;
        --name|--verbose|--sandbox|--no-sandbox)
            if [[ "$1" == "--name" ]]; then
                RC_ARGS+=("$1" "$2"); shift
            else
                RC_ARGS+=("$1")
            fi
            ;;
        *)
            RC_ARGS+=("$1")
            ;;
    esac
    shift
done

# ── State ────────────────────────────────────────────────────────
_interrupted=0
_child_pid=""
_retries=0
_backoff="$BACKOFF_INITIAL"
_total_sessions=0

# ── Helpers ──────────────────────────────────────────────────────
log() {
    printf '\033[36m[claude-watch %s]\033[0m %s\n' "$(date '+%H:%M:%S')" "$*" >&2
}

cleanup() {
    _interrupted=1
    if [[ -n "$_child_pid" ]] && kill -0 "$_child_pid" 2>/dev/null; then
        kill -TERM "$_child_pid" 2>/dev/null
        wait "$_child_pid" 2>/dev/null || true
    fi
}

fmt_duration() {
    local s=$1
    if [[ $s -ge 3600 ]]; then
        printf '%dh%dm%ds' $((s/3600)) $((s%3600/60)) $((s%60))
    elif [[ $s -ge 60 ]]; then
        printf '%dm%ds' $((s/60)) $((s%60))
    else
        printf '%ds' "$s"
    fi
}

trap cleanup INT TERM

# ── Main loop ────────────────────────────────────────────────────
log "monitoring remote-control sessions (pid $$)"
[[ ${#RC_ARGS[@]} -gt 0 ]] && log "remote-control args: ${RC_ARGS[*]}"

while true; do
    _total_sessions=$(( _total_sessions + 1 ))
    start_ts=$(date +%s)

    if [[ $_total_sessions -eq 1 ]]; then
        log "starting remote-control session..."
    else
        log "starting new remote-control session (#$_total_sessions)..."
    fi

    # Launch claude remote-control, track its PID
    "$CLAUDE_CMD" remote-control "${RC_ARGS[@]}" &
    _child_pid=$!
    wait "$_child_pid" 2>/dev/null
    exit_code=$?
    _child_pid=""

    elapsed=$(( $(date +%s) - start_ts ))
    uptime_str=$(fmt_duration "$elapsed")

    # Clean exit via Ctrl+C — don't reconnect
    if [[ $_interrupted -eq 1 ]]; then
        log "interrupted — exiting (ran $_total_sessions session(s))"
        exit 0
    fi

    # Exit code 0 means user quit normally — don't reconnect
    if [[ $exit_code -eq 0 ]]; then
        log "remote-control exited normally — done (ran $_total_sessions session(s))"
        exit 0
    fi

    # Bump retry counter
    _retries=$(( _retries + 1 ))

    # Check max retries
    if [[ $MAX_RETRIES -gt 0 && $_retries -ge $MAX_RETRIES ]]; then
        log "max retries ($MAX_RETRIES) reached — giving up"
        exit "$exit_code"
    fi

    # Reset backoff if the session was stable long enough
    if [[ $elapsed -ge $BACKOFF_RESET_AFTER ]]; then
        _backoff="$BACKOFF_INITIAL"
        _retries=0
    fi

    log "session dropped (code $exit_code, uptime $uptime_str) — reconnecting in ${_backoff}s [attempt $_retries]"

    # Interruptible sleep
    sleep "$_backoff" &
    wait $! 2>/dev/null || {
        if [[ $_interrupted -eq 1 ]]; then
            log "interrupted during backoff — exiting"
            exit 0
        fi
    }

    # Increase backoff
    _backoff=$(( _backoff * BACKOFF_MULTIPLIER ))
    if [[ $_backoff -gt $BACKOFF_MAX ]]; then
        _backoff=$BACKOFF_MAX
    fi
done
