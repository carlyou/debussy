#!/usr/bin/env bash
#
# claude-watch — lightweight auto-reconnect wrapper for claude CLI
#
# Usage: ./claude-watch [claude args...]
#
# Monitors the claude process and automatically reconnects on
# unexpected disconnects. Ctrl+C exits cleanly without reconnecting.
#
set -euo pipefail

# ── Configuration (override via environment) ─────────────────────
CLAUDE_CMD="${CLAUDE_CMD:-claude}"
BACKOFF_INITIAL="${BACKOFF_INITIAL:-1}"     # seconds
BACKOFF_MAX="${BACKOFF_MAX:-30}"            # seconds
BACKOFF_MULTIPLIER="${BACKOFF_MULTIPLIER:-2}"
BACKOFF_RESET_AFTER="${BACKOFF_RESET_AFTER:-60}"  # reset backoff after N seconds of uptime
MAX_RETRIES="${MAX_RETRIES:-0}"            # 0 = unlimited

# ── State ────────────────────────────────────────────────────────
_interrupted=0
_child_pid=""
_retries=0
_backoff="$BACKOFF_INITIAL"

# ── Helpers ──────────────────────────────────────────────────────
log() { printf '\033[90m[claude-watch %s]\033[0m %s\n' "$(date '+%H:%M:%S')" "$*" >&2; }

cleanup() {
    _interrupted=1
    if [[ -n "$_child_pid" ]] && kill -0 "$_child_pid" 2>/dev/null; then
        kill -TERM "$_child_pid" 2>/dev/null
        wait "$_child_pid" 2>/dev/null || true
    fi
}

trap cleanup INT TERM

# ── Main loop ────────────────────────────────────────────────────
log "starting (pid $$)"
[[ $# -gt 0 ]] && log "args: $*"

while true; do
    start_ts=$(date +%s)

    # Launch claude in foreground, but track its PID
    "$CLAUDE_CMD" "$@" &
    _child_pid=$!
    wait "$_child_pid" 2>/dev/null
    exit_code=$?
    _child_pid=""

    elapsed=$(( $(date +%s) - start_ts ))

    # Clean exit via Ctrl+C — don't reconnect
    if [[ $_interrupted -eq 1 ]]; then
        log "interrupted — exiting"
        exit 0
    fi

    # Exit code 0 means normal quit — don't reconnect
    if [[ $exit_code -eq 0 ]]; then
        log "claude exited normally (code 0) — done"
        exit 0
    fi

    # Bump retry counter
    _retries=$(( _retries + 1 ))

    # Check max retries
    if [[ $MAX_RETRIES -gt 0 && $_retries -ge $MAX_RETRIES ]]; then
        log "max retries ($MAX_RETRIES) reached — giving up"
        exit "$exit_code"
    fi

    # Reset backoff if the session was stable long enough
    if [[ $elapsed -ge $BACKOFF_RESET_AFTER ]]; then
        _backoff="$BACKOFF_INITIAL"
    fi

    log "disconnected (code $exit_code, uptime ${elapsed}s) — reconnecting in ${_backoff}s [attempt $_retries]"

    # Interruptible sleep
    sleep "$_backoff" &
    wait $! 2>/dev/null || {
        # sleep was interrupted (Ctrl+C during backoff)
        if [[ $_interrupted -eq 1 ]]; then
            log "interrupted during backoff — exiting"
            exit 0
        fi
    }

    # Increase backoff
    _backoff=$(( _backoff * BACKOFF_MULTIPLIER ))
    if [[ $_backoff -gt $BACKOFF_MAX ]]; then
        _backoff=$BACKOFF_MAX
    fi
done
